+/// iOS 上由宿主 App 把当前真正上网的网卡名写进 ET_BIND_IF（随网络变化更新）
+#[cfg(target_os = "ios")]
+fn bind_if_name() -> Option<String> {
+    std::env::var("ET_BIND_IF").ok().filter(|v| !v.is_empty() && v != "auto")
+}
+
+/// ET_BIND_IF=auto：取默认路由里第一个不是隧道（utun/ipsec/ppp）的网卡，30 秒刷新一次
+#[cfg(target_os = "macos")]
+fn bind_if_name() -> Option<String> {
+    use std::sync::Mutex;
+    use std::time::{Duration, Instant};
+    static CACHE: Mutex<Option<(Instant, Option<String>)>> = Mutex::new(None);
+    let want = std::env::var("ET_BIND_IF").ok()?;
+    if want != "auto" {
+        return Some(want);
+    }
+    let mut cache = CACHE.lock().unwrap();
+    if let Some((t, v)) = cache.as_ref() {
+        if t.elapsed() < Duration::from_secs(30) {
+            return v.clone();
+        }
+    }
+    let out = std::process::Command::new("/usr/sbin/netstat").args(["-rn", "-f", "inet"]).output().ok();
+    let found = out.and_then(|o| {
+        String::from_utf8_lossy(&o.stdout).lines().filter(|l| l.starts_with("default")).find_map(|l| {
+            let netif = l.split_whitespace().nth(3)?;
+            let tunnel = ["utun", "ipsec", "ppp", "tun", "gif", "stf"].iter().any(|p| netif.starts_with(p));
+            (!tunnel).then(|| netif.to_string())
+        })
+    });
+    *cache = Some((Instant::now(), found.clone()));
+    found
+}
+
+/// Pivot 补丁：macOS 上 Shadowrocket 等代理的 TUN 会接管默认路由，没绑网卡的 UDP 套接字（STUN、打洞）
+/// 都被带进代理，NAT 被误判为对称型、打洞失败。设置 ET_BIND_IF=en0 时，把这些套接字绑到指定的物理网卡。
+pub async fn bind_udp<A: tokio::net::ToSocketAddrs>(addr: A) -> std::io::Result<tokio::net::UdpSocket> {
+    let sock = tokio::net::UdpSocket::bind(addr).await?;
+    let v4 = sock.local_addr()?.is_ipv4();
+    bind_to_physical_if(socket2::SockRef::from(&sock), v4);
+    Ok(sock)
+}
+
+/// 同上，用于 TCP STUN 等自己建的套接字（要在 connect 之前调用）
+#[allow(unused_variables)]
+pub fn bind_to_physical_if(s: socket2::SockRef<'_>, v4: bool) {
+    #[cfg(any(target_os = "macos", target_os = "ios"))]
+    if let Some(name) = bind_if_name() {
+        let idx = nix::net::if_::if_nametoindex(name.as_str()).unwrap_or(0);
+        if let Some(idx) = std::num::NonZeroU32::new(idx) {
+            let r = if v4 { s.bind_device_by_index_v4(Some(idx)) } else { s.bind_device_by_index_v6(Some(idx)) };
+            if let Err(e) = r { tracing::warn!(?e, "ET_BIND_IF bind failed"); }
+        }
+    }
+}
